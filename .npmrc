# npm 配置 —— 本包**零外部运行时依赖**，这些设置都是为了防止意外引入依赖，
# 并让 CI 的安装步骤可复现。

# 精确锁定版本，不用 ^ 漂移。本包只有一个 peer 的 schemastery 声明在
# dependencies 里（DSH 运行时提供），它必须与实际运行时版本兼容。
save-exact=true

# 不生成 package-lock（我们用 pnpm-lock.yaml）。
package-lock=false

# 安装时不跑脚本 —— 本包没有需要构建的原生模块，
# 而 postinstall 脚本是供应链攻击的常见载体。
#
# ⚠ 这个文件**只在本包目录内生效**（npm/pnpm 读的是最近的 .npmrc）。
# 它不会影响 DSH profile 里其他插件的安装 —— 那读的是 profile 目录的配置。
# 本包没有 prepare/postinstall 脚本（无构建步骤），所以 git 安装不受影响。
ignore-scripts=true

# 审计与 funding 提示在 CI 里是噪声（CI 用 --no-audit --no-fund 显式关掉）。
audit=false
fund=false

# 安装失败时把 pnpm 的报错写清楚（默认输出对 Windows 路径不友好）。
loglevel=warn
