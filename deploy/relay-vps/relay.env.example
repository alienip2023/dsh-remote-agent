# dsh-remote-relay 环境文件模板
#
# 安装：sudo install -m 0600 -o root -g root relay.env.example /etc/dsh-remote-relay/env
# 然后编辑占位符。systemd unit 通过 EnvironmentFile= 读它。
#
# 权限必须是 0600 root:root —— 这里面是两个凭证的明文。

# 监听地址。套了 TLS 前置（Caddyfile / nginx.conf 模板）时填 127.0.0.1，
# 公网只看到反向代理的 443；不套 TLS 才填 0.0.0.0（并务必把来源限到两端 IP）。
DSH_RELAY_HOST=127.0.0.1
DSH_RELAY_PORT=8890

# 数据目录：tokens.json 落点（0700 dsh-relay:dsh-relay）
DSH_RELAY_DATA_DIR=/var/lib/dsh-remote-relay

# ── 凭证 ──────────────────────────────────────────────────────────────
# hub 端凭证：只有主电脑（hub）用，拨入时以 x-relay-token header 携带
DSH_RELAY_HUB_TOKEN=rt_REPLACE_WITH_GENERATED
# 入网凭证：副机（node）用；也支持一次性 token（管理接口铸造，15 分钟有效）
DSH_RELAY_ENROLL_TOKEN=en_REPLACE_WITH_GENERATED
